# Copiez ce fichier vers .env pour le lancement Docker local.
# Ne publiez jamais votre vrai .env sur GitHub.
DB_NAME=holakids
DB_USERNAME=holakids
DB_PASSWORD=change-this-local-postgres-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=/api/v1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
SEED_ENABLED=true
DATASET_PATH=datasets/products.json
ADMIN_EMAIL=AbdelatifMada@gmail.com
ADMIN_PASSWORD=change-this-admin-password
CLIENT_EMAIL=client@holakids.ma
CLIENT_PASSWORD=change-this-client-password
